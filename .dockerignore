# Docker build context - the repository root (both Dockerfiles copy apps/<app>/).
# The main goal is to keep secrets (.env) and local builds out of the image.
.git
.github
node_modules
**/node_modules
**/.env
**/.env.*
!**/.env.example
**/*.local.*
apps/cms/.tmp
apps/cms/.cache
apps/cms/.strapi
apps/cms/.strapi-updater.json
apps/cms/build
apps/cms/dist
apps/cms/types/generated
apps/cms/public/uploads/*
!apps/cms/public/uploads/.gitkeep
apps/web/.next
apps/web/out
apps/web/.leads-outbox
apps/web/next-env.d.ts
**/*.tsbuildinfo
**/*.log
**/.claude
deploy
docs
