# --- Server ---
HOST=0.0.0.0
PORT=1337
# Public Strapi URL (in production: https://cms.<domain>)
PUBLIC_URL=http://localhost:1337

# --- Secrets: generate for each environment ---
# node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Database ---
# dev: SQLite (file .tmp/data.db, nothing to configure)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# prod: PostgreSQL — uncomment and fill in
# DATABASE_CLIENT=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=kestrow
# DATABASE_USERNAME=kestrow
# DATABASE_PASSWORD=
# DATABASE_SSL=false
# Alternative to the separate fields: a connection string
# DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5432/kestrow

# --- Demo content (dev only) ---
# true — fill an empty DB with demo data and menus; force — recreate; in production — false
SEED_DEMO=false

# --- Site cache reset (Strapi webhook → Next.js /api/revalidate) ---
# Strapi creates the webhook on startup when both variables are set. The secret is the same as in apps/web
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# --- Proxy and limits (production: deploy/env/cms.env.example) ---
# true — behind a reverse proxy (Caddy/nginx): trust X-Forwarded-*, client IP is the last X-Forwarded-For address
BEHIND_PROXY=false
# CORS: origins the browser may call the API from directly; empty — default (*). In production: the admin and site origins
CORS_ORIGINS=
# Media library file size limit, MB (also used in strapi::body)
UPLOAD_SIZE_LIMIT_MB=50
# Responsive image copies (large/medium/small): false — disable (small server); empty — as set in the admin
MEDIA_RESPONSIVE_DIMENSIONS=
