{
  "kind": "collectionType",
  "collectionName": "kitchen_categories",
  "info": {
    "singularName": "kitchen-category",
    "pluralName": "kitchen-categories",
    "displayName": "Body type",
    "description": "Body type of a vehicle: SUVs, sedans, pickup trucks and so on"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "shortName": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "description": {
      "type": "text"
    },
    "kitchens": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::kitchen.kitchen",
      "mappedBy": "category"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
