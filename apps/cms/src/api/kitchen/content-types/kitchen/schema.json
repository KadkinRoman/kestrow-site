{
  "kind": "collectionType",
  "collectionName": "kitchens",
  "info": {
    "singularName": "kitchen",
    "pluralName": "kitchens",
    "displayName": "Vehicle",
    "description": "Vehicle listing: a car in the inventory (price, mileage, year, specs, photos)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::kitchen-category.kitchen-category",
      "inversedBy": "kitchens"
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "oldPrice": {
      "type": "integer",
      "min": 0
    },
    "dimensions": {
      "type": "string",
      "description": "Mileage, e.g. 24,300 mi"
    },
    "height": {
      "type": "string",
      "description": "Model year, e.g. 2022"
    },
    "shortDesc": {
      "type": "string",
      "description": "Short line for the card: body · fuel · drivetrain · mileage"
    },
    "description": {
      "type": "blocks"
    },
    "highlights": {
      "type": "component",
      "repeatable": true,
      "component": "kitchen.highlight",
      "description": "Key features of the car"
    },
    "style": {
      "type": "enumeration",
      "enum": [
        "gasoline",
        "hybrid",
        "plug-in-hybrid",
        "electric",
        "diesel"
      ],
      "default": "gasoline",
      "description": "Fuel"
    },
    "facade": {
      "type": "enumeration",
      "enum": [
        "awd",
        "four-wd",
        "fwd",
        "rwd"
      ],
      "default": "awd",
      "description": "Drivetrain"
    },
    "color": {
      "type": "enumeration",
      "enum": [
        "white",
        "black",
        "silver",
        "blue",
        "red"
      ],
      "default": "white",
      "description": "Exterior color"
    },
    "badge": {
      "type": "string",
      "description": "Label on the card, e.g. “Great price”, “Just arrived”"
    },
    "isHit": {
      "type": "boolean",
      "default": false,
      "description": "Mark as popular"
    },
    "specs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.spec"
    },
    "included": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item",
      "description": "Included with every car"
    },
    "excluded": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item",
      "description": "Optional extras"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "legacyPath": {
      "type": "string",
      "description": "Legacy URL on the previous site — used for a 301 redirect"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::kitchen-tag.kitchen-tag",
      "inversedBy": "kitchens"
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "kitchen"
    }
  }
}
