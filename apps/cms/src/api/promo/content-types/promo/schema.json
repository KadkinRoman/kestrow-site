{
  "kind": "collectionType",
  "collectionName": "promos",
  "info": {
    "singularName": "promo",
    "pluralName": "promos",
    "displayName": "Special offer",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "shortText": {
      "type": "text"
    },
    "text": {
      "type": "text"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "sale",
        "gift"
      ],
      "default": "sale"
    },
    "isMain": {
      "type": "boolean",
      "default": false
    },
    "endsAt": {
      "type": "date"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "legacyPath": {
      "type": "string"
    }
  }
}
