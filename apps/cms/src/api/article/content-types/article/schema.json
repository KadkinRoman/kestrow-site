{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "lead": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "tag": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::article-tag.article-tag",
      "inversedBy": "articles"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "articles"
    },
    "expert": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "expertArticles"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "readingMinutes": {
      "type": "integer",
      "min": 1
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "article.text",
        "article.image",
        "article.tip",
        "article.quote",
        "article.cta",
        "article.table"
      ]
    },
    "legacyPath": {
      "type": "string"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
