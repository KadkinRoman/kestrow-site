# Public site URL (canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Strapi ---
# API address for the Next server (in dev use 127.0.0.1: Strapi listens on IPv4)
STRAPI_URL=http://127.0.0.1:1337
# Public Strapi address for /uploads images (in production — https://cms.<domain>)
STRAPI_PUBLIC_URL=http://localhost:1337
# Optional: Settings → API Tokens → Read-only (without a token the Public role permissions apply)
STRAPI_API_TOKEN=
# Cache-revalidation webhook secret — the same as REVALIDATE_SECRET in apps/cms/.env
REVALIDATE_SECRET=

# --- Leads → Bitrix24 (optional integration) ---
# Incoming webhook (a dedicated one, CRM scope): https://<portal>.bitrix24.com/rest/<user_id>/<token>/
BITRIX24_WEBHOOK_URL=
# true — actually create leads (crm.item.add). Keep false in dev and demos: the request is only written to the log
LEADS_SEND_TO_CRM=false
# Optional: id of the user responsible for website leads (otherwise — the webhook owner)
BITRIX24_LEAD_ASSIGNED_BY_ID=

# --- Request outbox (Bitrix24 unavailable → the request goes to disk, a background worker retries) ---
# Outbox folder: in production a container volume (for example /data/leads); defaults to .leads-outbox in the app directory
LEADS_OUTBOX_DIR=
# How often to retry deferred requests, in seconds (default 120)
LEADS_OUTBOX_INTERVAL_SEC=
# Notify the team about a request stuck in the outbox — a Telegram bot (the token is a secret) and the team chat.
# Prefer a dedicated notification bot rather than a bot connected to a CRM channel: messages sent to a group with that bot would reach the CRM as conversations
LEADS_ALERT_TG_BOT_TOKEN=
LEADS_ALERT_TG_CHAT_ID=

# --- Dev: open the site from a phone on the same network (the computer's IP, comma-separated) ---
DEV_ALLOWED_ORIGINS=

# --- Analytics (optional) ---
NEXT_PUBLIC_YANDEX_METRIKA_ID=
