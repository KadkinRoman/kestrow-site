# Monitoring and backups (healthcheck.sh, backup.sh) -> /opt/<project>/env/monitor.env, mode 600.

# Public addresses of this environment
SITE_URL=https://kestrow.193-233-216-209.sslip.io
CMS_URL=https://cms-kestrow.193-233-216-209.sslip.io
# user:password for /api/health if the site sits behind basic auth (empty for the public demo)
BASIC_AUTH=

# Telegram alerts (empty - only the data/monitor.log journal)
ALERT_TG_BOT_TOKEN=
ALERT_TG_CHAT_ID=
# Disk usage threshold, %
DISK_WARN_PCT=85

# Backups: how many daily and monthly copies to keep
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=3
# Off-site copy: an rclone remote (for example s3backup:kestrow-backups); empty - do not copy
OFFSITE_RCLONE_REMOTE=
