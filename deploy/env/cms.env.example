# Strapi (cms container) -> /opt/<project>/env/cms.env, mode 600. Keep a copy of the secrets in your password manager.
# DATABASE_CLIENT/HOST/PORT, NODE_ENV, NODE_OPTIONS and BEHIND_PROXY are set by compose.yaml.

HOST=0.0.0.0
PORT=1337
# Public address of the admin panel and media library (as in Caddy)
PUBLIC_URL=https://cms-kestrow.193-233-216-209.sslip.io

# --- Secrets: unique per environment. Generate with: openssl rand -base64 16 (APP_KEYS - four values, comma-separated) ---
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Database (same as in db.env) ---
DATABASE_NAME=kestrow
DATABASE_USERNAME=kestrow
DATABASE_PASSWORD=
DATABASE_SSL=false

# --- Demo content: true on the first start into an empty database (skipped afterwards); this is a demo site with seeded content ---
SEED_DEMO=true

# --- Site cache reset: the webhook goes over the internal network, same secret as REVALIDATE_SECRET in web.env ---
FRONTEND_REVALIDATE_URL=http://web:3000/api/revalidate
REVALIDATE_SECRET=

# --- Proxy and limits ---
# CORS: browsers do not call the API directly (the site reads it on the server) - only own origins
CORS_ORIGINS=https://cms-kestrow.193-233-216-209.sslip.io,https://kestrow.193-233-216-209.sslip.io
# Media library file size limit, MB (also used in strapi::body); set the proxy limit for this host slightly higher
UPLOAD_SIZE_LIMIT_MB=50
# Responsive image copies (large/medium/small): false on a small server
MEDIA_RESPONSIVE_DIMENSIONS=false

# --- Admin panel without extra popups ---
FLAG_NPS=false
FLAG_PROMOTE_EE=false
