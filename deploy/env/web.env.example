# Next.js (web container) -> /opt/<project>/env/web.env, mode 600.
# STRAPI_URL (internal http://cms:1337), LEADS_OUTBOX_DIR, NODE_ENV, NODE_OPTIONS are set by compose.yaml.
# NEXT_PUBLIC_SITE_URL and STRAPI_PUBLIC_URL must match the values used when this environment's image was built (CI build-args).

NEXT_PUBLIC_SITE_URL=https://kestrow.193-233-216-209.sslip.io
STRAPI_PUBLIC_URL=https://cms-kestrow.193-233-216-209.sslip.io
# Optional: read-only Strapi API token (Settings -> API Tokens); without it the Public role permissions apply
STRAPI_API_TOKEN=
# Cache reset webhook secret - same as REVALIDATE_SECRET in cms.env
REVALIDATE_SECRET=

# --- Leads -> Bitrix24 ---
# Incoming webhook with the crm scope. In the demo it is empty and LEADS_SEND_TO_CRM=false: a request is only logged
BITRIX24_WEBHOOK_URL=
LEADS_SEND_TO_CRM=false
BITRIX24_LEAD_ASSIGNED_BY_ID=
# Retry interval for queued leads, seconds (default 120)
LEADS_OUTBOX_INTERVAL_SEC=
# Alert to the sales team about a queued lead (a dedicated bot)
LEADS_ALERT_TG_BOT_TOKEN=
LEADS_ALERT_TG_CHAT_ID=
