# docker compose variables for one site instance -> copy to /opt/<project>/.env.
# No secrets here - they live in env/*.env (see env/*.env.example).

# Compose project name = prefix of container names (<project>-db, -cms, -web), volumes and Caddy upstream names
COMPOSE_PROJECT_NAME=kestrow

# Images from GHCR and their tags. deploy.sh changes the tags (v1.2.3, sha-1a2b3c4); edit by hand only for the very first start
CMS_IMAGE=ghcr.io/kadkinroman/kestrow-cms
CMS_TAG=main
WEB_IMAGE=ghcr.io/kadkinroman/kestrow-web
WEB_TAG=prod-main
# Web tag prefix of this environment (stage | prod): deploy.sh v1.2.3 -> WEB_TAG=prod-v1.2.3
WEB_TAG_PREFIX=prod

# Folder with the service and monitoring env files (absolute path)
ENV_DIR=/opt/kestrow/env

# External docker network of the reverse proxy (Caddy). On the shared demo server it is b24net;
# on your own server create one: docker network create proxy
PROXY_NETWORK=b24net
